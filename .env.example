# ============================================================
# DocReady — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit your actual .env file to version control.
# This file shows required variables without exposing secrets.
# ============================================================


# ------------------------------------------------------------
# APP SETTINGS
# ------------------------------------------------------------

# Environment: development | production
APP_ENV=development

# Port the server will listen on (used by future Flask backend)
PORT=5000

# Public base URL of the deployed app (no trailing slash)
APP_BASE_URL=http://localhost:5000

# Secret key for Flask sessions and CSRF protection
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here


# ------------------------------------------------------------
# FUTURE BACKEND — Python / Flask
# (Not used in the current frontend-only PoC)
# ------------------------------------------------------------

# Flask debug mode: true | false (never true in production)
FLASK_DEBUG=false

# Database URL (if a database is added in future)
# DATABASE_URL=postgresql://user:password@localhost:5432/docready


# ------------------------------------------------------------
# SMS REMINDER AGENT (Future Scope)
# ------------------------------------------------------------

# Twilio credentials for SMS reminders feature
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890


# ------------------------------------------------------------
# ANALYTICS (Optional / Future)
# ------------------------------------------------------------

# Plausible or self-hosted analytics site key (privacy-first, no cookies)
# ANALYTICS_DOMAIN=doc-ready.vercel.app


# ------------------------------------------------------------
# VERCEL DEPLOYMENT
# ------------------------------------------------------------

# Vercel project and team details (used by Vercel CLI)
# VERCEL_PROJECT_ID=your-vercel-project-id
# VERCEL_ORG_ID=your-vercel-org-id
# VERCEL_TOKEN=your-vercel-api-token


# ============================================================
# NOTE: The current DocReady PoC is fully frontend (no server).
# All variables above apply to the planned Python/Flask backend.
# No user data is collected, stored, or transmitted in the PoC.
# ============================================================
