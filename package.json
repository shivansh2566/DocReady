{
  "name": "docready",
  "version": "1.0.0",
  "description": "Government Document Checklist for Indian Citizens",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "knip": "knip"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/*.test.js"],
    "collectCoverageFrom": ["app.logic.js"],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 70,
        "statements": 80
      }
    },
    "coverageReporters": ["text", "lcov", "cobertura"]
  },
  "knip": {
    "entry": ["app.js"],
    "project": ["*.js"],
    "ignore": ["app.logic.js", "eslint.config.js"],
    "ignoreDependencies": ["jest-environment-jsdom"]
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "knip": "^5.0.0"
  }
}
