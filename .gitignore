# ============================================================
# DocReady — .gitignore
# ============================================================


# ------------------------------------------------------------
# Secrets & environment — NEVER commit these
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12
secrets/
credentials/


# ------------------------------------------------------------
# Node / JavaScript
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm/
.yarn/
.pnp.*
.eslintcache
.parcelcache/
dist/
build/
.cache/
*.tsbuildinfo


# ------------------------------------------------------------
# Python / Flask (future backend)
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
*.egg
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml
test-results/


# ------------------------------------------------------------
# Android / Capacitor APK build
# ------------------------------------------------------------
android/
ios/
.capacitor/
android/build/
android/.gradle/
android/app/build/
android/local.properties
*.apk
*.aab
*.keystore
*.jks


# ------------------------------------------------------------
# IDE & editor files
# ------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
*~


# ------------------------------------------------------------
# OS generated files
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


# ------------------------------------------------------------
# Logs & temp files
# ------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.bak
*.orig
tmp/
temp/


# ------------------------------------------------------------
# Test & coverage output
# ------------------------------------------------------------
coverage/
.nyc_output/
test-results/
cypress/videos/
cypress/screenshots/


# ------------------------------------------------------------
# Docker (local overrides — base files are committed)
# ------------------------------------------------------------
docker-compose.override.yml
.docker/


# ------------------------------------------------------------
# Git-cliff generated output (commit to repo when releasing)
# Uncomment the next line to keep CHANGELOG out of git
# ------------------------------------------------------------
# CHANGELOG.md


# ------------------------------------------------------------
# Vercel local config (generated by Vercel CLI)
# ------------------------------------------------------------
.vercel/


# ------------------------------------------------------------
# Data scraping scripts output (dev only)
# scripts/build_data.py writes here
# ------------------------------------------------------------
scripts/output/
scripts/__pycache__/
scripts/*.pyc


# ------------------------------------------------------------
# Miscellaneous
# ------------------------------------------------------------
*.zip
*.tar.gz
*.gz
*.rar
