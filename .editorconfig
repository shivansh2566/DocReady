# EditorConfig — DocReady
# https://editorconfig.org

root = true

# ─── Defaults for all files ───────────────────────────────────────────────────
[*]
charset             = utf-8
end_of_line         = lf
indent_style        = space
indent_size         = 2
trim_trailing_whitespace = true
insert_final_newline = true

# ─── Web source files ─────────────────────────────────────────────────────────
[*.{html,css,js}]
indent_size = 2

# ─── Data / config files ──────────────────────────────────────────────────────
[*.{json,jsonc}]
indent_size = 2

# ─── Markdown — preserve intentional trailing spaces (line breaks) ────────────
[*.md]
trim_trailing_whitespace = false

# ─── Shell scripts ────────────────────────────────────────────────────────────
[*.sh]
indent_size = 2

# ─── Makefiles require real tabs ──────────────────────────────────────────────
[Makefile]
indent_style = tab
